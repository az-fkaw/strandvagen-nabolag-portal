// The whole infrastructure, in one file: one Cloudflare Worker that serves
// the pages in public/ and answers /api/*, one D1 (SQLite) database, and one
// R2 bucket for pictures. Free plan: 100,000 requests and 5 million database
// row reads per day; 10 GB of pictures.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strandvagen-nabolag",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // Every page address (/kalender, /naboer, ...) loads index.html;
    // only /api/* reaches the Worker code.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nabolag",
      // First deploy: `npx wrangler d1 create nabolag --location weur`
      // prints a database_id. Paste it here (README, "First time").
      "database_id": "29db03d4-8043-4c3b-b14b-697657c4221d"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      // Create it before the first deploy that needs it (README, "Pictures").
      "bucket_name": "nabolag-bilder"
    }
  ],
  "observability": { "enabled": true }
}
